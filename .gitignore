# ==============================================================================
# .gitignore — Files that should NOT be committed to Git
# ==============================================================================

# --- Secrets (NEVER commit) ---
.env
.env.local
.env.*.local

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# --- Virtual environment ---
venv/
.venv/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
